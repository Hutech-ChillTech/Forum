## Application Properties Template 
Thong tin ben duoi deu duoc lay trong .env

# Server
server.port=${SERVER_PORT:8080}

# Spring application
spring.application.name=forum-backend

# Datasource
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:forumIT}
spring.datasource.username=${DB_USERNAME:your-servername}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver

# Connection pool tuning
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# JPA / Hibernate
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=false

# Redis Configuration
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.username=${REDIS_USERNAME:}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.ssl.enabled=${REDIS_SSL_ENABLED:false}
spring.data.redis.timeout=2000ms
spring.data.redis.connect-timeout=2000ms

# JWT  — secrets MUST be supplied via environment variables; no default fallback
jwt.secret=${JWT_SECRET:}
jwt.access-token.expiration=${JWT_ACCESS_TOKEN_EXPIRATION:3600000}
jwt.refresh-token.expiration=${JWT_REFRESH_TOKEN_EXPIRATION:604800000}

# CORS — supply allowed origins via env var (comma-separated)
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}

# Rate limiting — requests per minute per IP (default 1000)
app.rate-limit.capacity=${RATE_LIMIT_CAPACITY:1000}
app.rate-limit.refill-tokens=${RATE_LIMIT_REFILL_TOKENS:1000}
app.rate-limit.refill-minutes=${RATE_LIMIT_REFILL_MINUTES:1}

# WebSocket
app.websocket.allowed-origins=${WS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}
